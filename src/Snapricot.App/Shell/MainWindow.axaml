<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Snapricot.App.Shell"
        x:Class="Snapricot.App.Shell.MainWindow"
        x:DataType="shell:MainWindowViewModel"
        Title="Snapricot"
        Icon="/Assets/snapricot.png"
        Width="960" Height="600" MinWidth="720" MinHeight="480"
        Background="{StaticResource ShellBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="220,*">

    <!-- Sidebar: items come from the module catalog; selection styling lives in App.axaml (ListBox.nav) -->
    <Border Background="{StaticResource ShellSidebarBrush}"
            BorderBrush="{StaticResource ShellBorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="18,18,16,16">
          <Image Source="/Assets/snapricot.png" Width="30" Height="30" />
          <TextBlock Text="Snapricot" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"
                     Foreground="{StaticResource BrandPlumBrush}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding VersionText}" FontSize="11" Margin="18,12"
                   Foreground="{StaticResource ShellMutedTextBrush}" />

        <ListBox Classes="nav" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedItem}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="shell:NavItemViewModel">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Data="{Binding Icon}" Width="18" Height="18" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <ContentControl Grid.Column="1" Content="{Binding CurrentView}" />
  </Grid>
</Window>
