<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Snapricot.App.App"
             RequestedThemeVariant="Light">

  <!--
    Brand palette: this file is the source of truth. Modules must use these keys
    (DynamicResource) rather than hardcoded hex values, so a palette change is one edit here.
  -->
  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="BrandApricot">#F4943C</Color>
      <Color x:Key="BrandApricotDeep">#D9622B</Color>
      <Color x:Key="BrandFlesh">#FFC98F</Color>
      <Color x:Key="BrandLeaf">#3E9B6A</Color>
      <Color x:Key="BrandPlum">#2E2240</Color>

      <SolidColorBrush x:Key="BrandApricotBrush" Color="{StaticResource BrandApricot}" />
      <SolidColorBrush x:Key="BrandApricotDeepBrush" Color="{StaticResource BrandApricotDeep}" />
      <SolidColorBrush x:Key="BrandPlumBrush" Color="{StaticResource BrandPlum}" />

      <!-- Light shell surfaces -->
      <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ShellSidebarBrush" Color="#FCF8F4" />
      <SolidColorBrush x:Key="ShellBorderBrush" Color="#F0E6DC" />
      <SolidColorBrush x:Key="ShellMutedTextBrush" Color="#8A7F76" />

      <!-- Square edges everywhere (approved 2026-10-09). Fluent reads these for buttons, text boxes, combo boxes and
           popups. Toggle switches draw their own pill shape and stay round on purpose. -->
      <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="BrandTintBrush" Color="#FFF1E4" />
          <SolidColorBrush x:Key="BrandTintTextBrush" Color="#9A3F14" />

          <!-- Light, outlined secondary buttons (Fluent's default grey felt heavy); accent buttons are unchanged. -->
          <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFF1E4" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FBE3D0" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="#E7DED5" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#D9622B" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#D9622B" />
          <SolidColorBrush x:Key="ButtonForeground" Color="#2E2240" />
          <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#9A3F14" />
          <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#9A3F14" />
          <Thickness x:Key="ButtonBorderThemeThickness">1</Thickness>

          <!-- Softer "off" toggles: warm grey instead of black. -->
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#8A7F76" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#6F655D" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#CFC5BB" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#B8ADA3" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="BrandTintBrush" Color="#4A2A1C" />
          <SolidColorBrush x:Key="BrandTintTextBrush" Color="#FFC98F" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#D9622B" />
        <ColorPaletteResources x:Key="Dark" Accent="#D9622B" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <!-- Shared text styles for settings pages (modules use these classes too). -->
    <Style Selector="TextBlock.description">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMutedTextBrush}" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMutedTextBrush}" />
    </Style>

    <!-- Light text selection (the solid accent made selected text hard to read). -->
    <Style Selector="TextBox">
      <Setter Property="SelectionBrush" Value="#FFD9C2" />
      <Setter Property="SelectionForegroundBrush" Value="#2E2240" />
    </Style>

    <!-- Every Snapricot window (including module dialogs) gets the app icon; modules don't need to know the asset. -->
    <Style Selector="Window">
      <Setter Property="Icon" Value="/Assets/snapricot.png" />
    </Style>

    <!-- Sidebar navigation: apricot tint on hover, solid apricot when selected -->
    <Style Selector="ListBox.nav">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- Flat, full-width items (approved style A): no side margin, no rounding, solid apricot when selected. -->
    <Style Selector="ListBox.nav ListBoxItem">
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="22,11" />
      <Setter Property="Foreground" Value="{StaticResource BrandPlumBrush}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrandTintBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource BrandTintTextBrush}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrandApricotDeepBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrandApricotDeepBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </Application.Styles>
</Application>
