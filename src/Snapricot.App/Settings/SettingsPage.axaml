<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Snapricot.App.Settings"
             x:Class="Snapricot.App.Settings.SettingsPage"
             x:DataType="settings:SettingsPageViewModel">
  <TabControl ItemsSource="{Binding Tabs}" Padding="0" Margin="10,6,0,0">
    <TabControl.ItemTemplate>
      <DataTemplate x:DataType="settings:SettingsTabViewModel">
        <TextBlock Text="{Binding Title}" FontSize="14" />
      </DataTemplate>
    </TabControl.ItemTemplate>
    <TabControl.ContentTemplate>
      <DataTemplate x:DataType="settings:SettingsTabViewModel">
        <ContentControl Content="{Binding Content}" />
      </DataTemplate>
    </TabControl.ContentTemplate>
  </TabControl>
</UserControl>
