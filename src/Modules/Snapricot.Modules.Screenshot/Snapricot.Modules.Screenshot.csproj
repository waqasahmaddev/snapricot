<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Feature module. Allowed references: Snapricot.Core and UI packages.
    Never reference another module or a Snapricot.Platform.* project (enforced by Snapricot.Architecture.Tests).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Snapricot.Modules.Screenshot.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Snapricot.Core\Snapricot.Core.csproj" />
  </ItemGroup>

</Project>
