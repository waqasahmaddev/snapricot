<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Snapricot.Modules.Screenshot.Capture.SaveCaptureDialog"
        Title="Save screenshot"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True"
        Background="{DynamicResource ShellBackgroundBrush}">
  <!-- Approved mockup: docs/product/design.md, "Save dialog". -->
  <StackPanel Margin="22,18,22,22" Spacing="16">

    <StackPanel Orientation="Horizontal" Spacing="12">
      <Border Width="120" Height="76" CornerRadius="6" ClipToBounds="True"
              BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1" Background="{DynamicResource ShellSidebarBrush}">
        <Image x:Name="Preview" Stretch="Uniform" />
      </Border>
      <StackPanel VerticalAlignment="Center" Spacing="4">
        <TextBlock x:Name="SizeText" FontSize="12" Foreground="{DynamicResource ShellMutedTextBrush}" />
        <TextBlock x:Name="FormatText" FontSize="12" Foreground="{DynamicResource ShellMutedTextBrush}" />
      </StackPanel>
    </StackPanel>

    <StackPanel Spacing="6">
      <TextBlock Text="File name" FontSize="12" Foreground="{DynamicResource ShellMutedTextBrush}" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBox x:Name="NameBox" />
        <TextBlock x:Name="ExtensionText" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource ShellMutedTextBrush}" />
      </Grid>
      <TextBlock x:Name="ErrorText" FontSize="12" Foreground="#A32D2D" IsVisible="False" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Spacing="6">
      <TextBlock Text="Save to" FontSize="12" Foreground="{DynamicResource ShellMutedTextBrush}" />
      <Border CornerRadius="8" Padding="10,4,4,4" BorderThickness="1"
              BorderBrush="{DynamicResource ShellBorderBrush}" Background="{DynamicResource ShellSidebarBrush}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
          <PathIcon Width="16" Height="16" Foreground="{DynamicResource BrandApricotDeepBrush}" VerticalAlignment="Center"
                    Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z" />
          <TextBlock x:Name="FolderText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="PrefixCharacterEllipsis"
                     Foreground="{DynamicResource BrandPlumBrush}" />
          <Border x:Name="DefaultBadge" Grid.Column="2" Padding="6,1" CornerRadius="4" VerticalAlignment="Center"
                  Background="{DynamicResource BrandTintBrush}">
            <TextBlock Text="Default" FontSize="11" Foreground="{DynamicResource BrandTintTextBrush}" />
          </Border>
          <Button x:Name="ChangeButton" Grid.Column="3" Content="Change…" FontSize="12" VerticalContentAlignment="Center" />
        </Grid>
      </Border>
      <TextBlock x:Name="FolderNote" FontSize="12" Foreground="{DynamicResource BrandTintTextBrush}" IsVisible="False" TextWrapping="Wrap" />
      <CheckBox x:Name="AlwaysBox" Content="Always save here (make this my default folder)" FontSize="12" />
    </StackPanel>

    <Border x:Name="TipPanel" CornerRadius="8" Padding="12,10" Background="{DynamicResource BrandTintBrush}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BrandTintTextBrush}"
                   Text="Copy saves to your default folder automatically. Use Save when you want a different name or folder." />
        <Button x:Name="DismissTipButton" Grid.Column="1" Padding="4" Background="Transparent" BorderThickness="0"
                VerticalAlignment="Top" ToolTip.Tip="Don't show this again">
          <PathIcon Width="12" Height="12" Foreground="{DynamicResource BrandTintTextBrush}"
                    Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" />
        </Button>
      </Grid>
    </Border>

    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
      <Button x:Name="CancelButton" Content="Cancel" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              Height="38" IsCancel="True" />
      <Button x:Name="SaveButton" Grid.Column="1" Content="Save" Classes="accent" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="38" IsDefault="True" />
    </Grid>
  </StackPanel>
</Window>
