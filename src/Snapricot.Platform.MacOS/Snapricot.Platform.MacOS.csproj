    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Snapricot.Core\Snapricot.Core.csproj" />
  </ItemGroup>

</Project>
